&pinctrl {
	/* EG800Q via TXS0108E. Direction LIKELY - confirm in KiCad before enabling uart0 */
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 8)>,    /* net UART_EG800Q_RXD -> MAIN_RXD */
				<NRF_PSEL(UART_RTS, 0, 27)>;  /* net EG800Q_RTS -> MAIN_RTS      */
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 6)>,    /* net UART_EG800Q_TXD <- MAIN_TXD */
				<NRF_PSEL(UART_CTS, 1, 8)>;   /* net EG800Q_CTS <- MAIN_CTS      */
			bias-pull-up;
		};
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 8)>,
				<NRF_PSEL(UART_RX, 0, 6)>,
				<NRF_PSEL(UART_RTS, 0, 27)>,
				<NRF_PSEL(UART_CTS, 1, 8)>;
			low-power-enable;
		};
	};
};
